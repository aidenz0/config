# ============================================
# Ghostty Terminal - Categorized Configuration
# ============================================
# File: ~/.config/ghostty/config.ghostty
# Reload: Cmd+Shift+, (macOS)
# View options: ghostty +show-config --default --docs

# --- 着色器 (Shader) ---
custom-shader = shaders/cursor_sweep.glsl
custom-shader = shaders/cursor_warp.glsl

# --- 窗口与标签栏 (Window & Tabs) --- 
# 背景透明度 (原 window-background-opacity)
background-opacity = 0.85

# 背景模糊半径 (原 window-background-blur-radius)
background-blur-radius = 20 
 
# --- 平台设置 (Platform) ---
macos-option-as-alt = true 

# --- 字体排版 (Typography) ---
 
font-family = "Monaco"

font-size = 16
# font-thicken = true
adjust-cell-height = 4

# --- 窗口与布局 (Window & Layout) ---
window-save-state = always
unfocused-split-opacity = 0.4
# background-opacity = 0.85
# background-blur-radius = 30
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-y = 8
# window-theme = auto

# --- 光标样式 (Cursor) ---
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.8

# --- 鼠标与选区 (Mouse & Selection) ---
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- 快捷终端 (Quick Terminal) ---
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- 安全设置 (Security) ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell 集成 (Shell Integration) ---
shell-integration = detect

# --- 性能设置 (Performance) ---
# Generous scrollback (25MB)
scrollback-limit = 25000000

# --- 键盘映射：标签页 (Keybindings: Tabs) ---
keybind = super+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# --- 键盘映射：分屏管理 (Keybindings: Splits) ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = super+h=goto_split:left
keybind = super+l=goto_split:right
keybind = super+k=goto_split:up
keybind = super+j=goto_split:down
 
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom
 
 
# --- 键盘映射：字体大小 (Keybindings: Font Size) ---
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# --- 键盘映射：配置与全局 (Keybindings: Config & Global) ---
keybind = cmd+shift+comma=reload_config
# keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = global:option+space=toggle_quick_terminal


theme = Dracula
